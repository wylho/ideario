{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ideario",
  "mainBinaryName": "ideario",
  "version": "0.1.0",
  "identifier": "app.ideario.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ideario",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#eef1ef",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: att: http://att.localhost; media-src 'self' blob: att: http://att.localhost; frame-src att: http://att.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Notas e ideias, local-first",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
